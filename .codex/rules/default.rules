prefix_rule(pattern=["git", ["add", "commit", "push", "fetch", "merge"]], decision="allow")
prefix_rule(pattern=["git", "branch", "-m"], decision="allow")
prefix_rule(pattern=["git", "worktree", "add", "--detach"], decision="allow")
prefix_rule(pattern=["gh", "pr", ["create", "view", "list", "checks", "merge"]], decision="allow")
prefix_rule(pattern=["gh", "run", ["view", "list"]], decision="allow")
prefix_rule(pattern=["pnpm", ["install", "format", "test", "typecheck", "build", "dev", "worktree:cleanup", "ship", "frames", "shot"]], decision="allow")
prefix_rule(pattern=["git", "checkout", "--detach", "origin/main"], decision="allow")
prefix_rule(pattern=["git", "push", ["--force", "--force-with-lease", "--force-if-includes", "-f"]], decision="forbidden", justification="Do not force-push.")
prefix_rule(pattern=["git", "push", "origin", ["--force", "--force-with-lease", "--force-if-includes", "-f"]], decision="forbidden", justification="Do not force-push.")
prefix_rule(pattern=["git", "branch", "-D"], decision="forbidden", justification="Delete merged branches with git branch -d.")
prefix_rule(pattern=["gh", "pr", "merge", "--admin"], decision="forbidden", justification="Do not bypass branch protection.")
prefix_rule(pattern=["gh", "stack", "merge"], decision="forbidden", justification="Do not merge a stack of pull requests.")
prefix_rule(pattern=["git", "worktree", "remove", ["--force", "-f"]], decision="forbidden", justification="Remove worktrees only without force.")
