{
  "name": "f1-pitwall",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build --configLoader native",
    "start": "node src/server/main.ts",
    "test": "prettier --check . && oxlint && node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "sessions": "node scripts/sessions.ts",
    "record": "node --env-file-if-exists=.env.local scripts/record.ts",
    "worktree:cleanup": "node scripts/worktree-cleanup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/oidc-auth": "^1.10.0",
    "@microsoft/signalr": "^10.0.11",
    "canvas-confetti": "^1.9.4",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.6.0",
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
